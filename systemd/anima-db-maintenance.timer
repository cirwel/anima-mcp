[Unit]
Description=Anima DB maintenance (WAL checkpoint + integrity check)

# Hourly jobs are staggered across the hour on purpose: :00 DB maintenance,
# :15 DB snapshot, :30 learned-state snapshot, :45 storage maintenance (which
# expects both snapshots to have run). No RandomizedDelaySec, so the order
# holds. No Persistent=, matching cron: a missed hour is not replayed at boot,
# when anima-restore may still be deciding which database is real.

[Timer]
OnCalendar=*-*-* *:00:00
AccuracySec=1min
Unit=anima-db-maintenance.service

[Install]
WantedBy=timers.target
